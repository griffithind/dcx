{
  "name": "Compose App",
  "plan": {
    "files": [
      "<workspace>/.devcontainer/docker-compose.yml",
      "<workspace>/.devcontainer/docker-compose.override.yml"
    ],
    "project": "compose_app-<id8>",
    "runServices": [
      "app",
      "db"
    ],
    "service": "app",
    "type": "compose"
  },
  "metadataImage": "alpine:3.20",
  "resourceName": "compose_app-<id8>",
  "sshHost": "compose_app.dcx",
  "overrideCommand": false,
  "workspaceFolder": "/workspace"
}
