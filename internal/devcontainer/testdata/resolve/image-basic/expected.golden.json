{
  "name": "Basic Image",
  "plan": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "type": "image"
  },
  "baseImage": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "metadataImage": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "resourceName": "basic_image-<id8>",
  "sshHost": "basic_image.dcx",
  "overrideCommand": true,
  "workspaceFolder": "/workspaces/proj",
  "workspaceMount": {
    "source": "<workspace>",
    "target": "/workspaces/proj",
    "type": "bind"
  },
  "remoteUser": "vscode",
  "effectiveUser": "vscode"
}
