{
  "name": "Metadata Image",
  "plan": {
    "image": "example.com/prebuilt:1",
    "type": "image"
  },
  "baseImage": "example.com/prebuilt:1",
  "metadataImage": "example.com/prebuilt:1",
  "resourceName": "metadata_image-<id8>",
  "sshHost": "metadata_image.dcx",
  "overrideCommand": false,
  "workspaceFolder": "/workspaces/proj",
  "workspaceMount": {
    "source": "<workspace>",
    "target": "/workspaces/proj",
    "type": "bind"
  },
  "remoteUser": "dev",
  "effectiveUser": "dev",
  "containerEnv": {
    "FROM_IMAGE": "1",
    "LOCAL": "1",
    "SHARED": "local"
  },
  "capAdd": [
    "SYS_PTRACE"
  ],
  "hooks": {
    "initialize": [
      "devcontainer.json: echo on-host"
    ],
    "postAttach": [
      "image: image-attach"
    ],
    "postCreate": [
      "image: echo from-image",
      "devcontainer.json: [a] echo a",
      "devcontainer.json: [b] echo b"
    ]
  }
}
