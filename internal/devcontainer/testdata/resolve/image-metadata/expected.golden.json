{
  "name": "Metadata Image",
  "plan": {
    "image": "example.com/prebuilt:1",
    "type": "image"
  },
  "baseImage": "example.com/prebuilt:1",
  "resourceName": "metadata_image-<id8>",
  "sshHost": "metadata_image.dcx",
  "overrideCommand": false,
  "workspaceFolder": "/workspaces/proj",
  "remoteUser": "dev",
  "effectiveUser": "dev",
  "containerEnv": {
    "FROM_IMAGE": "1",
    "LOCAL": "1",
    "SHARED": "local"
  },
  "capAdd": [
    "SYS_PTRACE"
  ]
}
