{
  "name": "proj",
  "plan": {
    "image": "alpine:3.20",
    "type": "image"
  },
  "baseImage": "alpine:3.20",
  "metadataImage": "alpine:3.20",
  "resourceName": "proj-<id8>",
  "sshHost": "<id>.dcx",
  "overrideCommand": true,
  "workspaceFolder": "/workspaces/proj",
  "mounts": [
    {
      "source": "<home>/.ssh",
      "target": "/root/.ssh",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "/var/run/docker.sock",
      "target": "/var/run/docker.sock",
      "type": "bind"
    },
    {
      "source": "/host/data",
      "target": "/data",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "named",
      "target": "/named",
      "type": "volume"
    },
    {
      "target": "/scratch",
      "type": "tmpfs"
    }
  ]
}
